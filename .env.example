# Application
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Public base URL of your app (for logs; set in cloud, e.g. https://your-app.onrender.com)
PUBLIC_URL=http://localhost:3000
# Comma-separated allowed browser origins, or leave unset for same-origin + open CORS in dev
# CORS_ORIGIN=https://your-frontend.com
# Set to 1 when running behind a reverse proxy (most cloud hosts)
# TRUST_PROXY=1

APP_NAME=Water Station Management System

# Aiven MySQL Database
AIVEN_DB_HOST=your-aiven-mysql-host.a.aivencloud.com
AIVEN_DB_PORT=21717
AIVEN_DB_NAME=defaultdb
AIVEN_DB_USER=avnadmin
AIVEN_DB_PASSWORD=your-aiven-password

# JWT Secret
JWT_SECRET=your-jwt-secret-key-change-this

# Payment Method
PAYMENT_METHOD=COD

# Logging
LOG_LEVEL=info
